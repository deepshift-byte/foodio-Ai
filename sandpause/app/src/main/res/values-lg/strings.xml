    <string name="owner_status_yes">Nnanyini kyuma: yee. Okuzibwa okujjuvu kukola.</string>
    <string name="owner_status_no">Nnanyini kyuma: nedda. Okuzibwa okw’omutindo kukozesebwa.</string>
    <string name="owner_fallback_note">Okuzibwa okw’omutindo kukola ku ssimu yonna. Kwetaagisa Accessibility n’okulabika ku app endala.</string>
    <string name="owner_adb_title">Teeka nnanyini kyuma (omulundi gumu, nga adb)</string>
    <string name="owner_adb_hint">Ku kompyuta erina Android platform tools, kwata essimu ng’oggulawo USB debugging, oddireyo:</string>
