    <!-- TODO(native review): permissions -->
    <string name="perm_title">Okukkirizibwa</string>
    <string name="perm_intro">SandPause eetaaga okukkirizibwa okutono okukuuma okuzibwa. Buli kimu kirina omulimu gumu, era osobola okukiggyako mu Settings.</string>
    <string name="perm_overlay_title">Kulabika ku app endala</string>
    <string name="perm_overlay_why">Ekifo ky’okuzibwa kisobole okubikka app eziziyiziddwa mangu.</string>
    <string name="perm_usage_title">Okukozesa okulaba</string>
    <string name="perm_usage_why">Engeri endala ey’okulaba app eriko, era n’okukuuma ekiseera ky’essimu.</string>
    <string name="perm_accessibility_title">Accessibility (okuzibwa okw’omutindo)</string>
    <string name="perm_accessibility_why">Ekozesebwa okulaba app eziziyiziddwa bwe zigguka, ekifo ky’okuzibwa kidde. Eno y’engeri enkulu ku ssimu ezitali mu kuzibwa okujjuvu.</string>
    <string name="perm_disclosure_title">Okubikkula okw’amaanyi</string>
    <string name="perm_disclosure_body">SandPause ekozesa Accessibility okulaba app eri ku ssirini yokka. Tesoma bigambo ku ssirini, tekuwandiika kye omwana akuba, era tesindika kintu kyonna ebweru w’essimu. Okuligulawo kyetaagisa okuzibwa okukola.</string>
    <string name="perm_disclosure_agree">Ntegeera era nkkiriza</string>
    <string name="perm_exact_alarm_title">Alamu ez’omutuufu</string>
    <string name="perm_exact_alarm_why">Enteekateeka y’okuzibwa etandike mu ddakiika entuufu.</string>
    <string name="perm_battery_title">Bbaatule</string>
    <string name="perm_battery_why">Eziyiza essimu okuggalawo SandPause emabega. Teeka SandPause ku Unrestricted oba Not optimised.</string>
    <string name="perm_calls_title">Okukuba essimu</string>
    <string name="perm_calls_why">Ssirini y’okuzibwa esobole okukuba ennamba z’obwetaavu n’abazadde b’olonze.</string>
    <string name="perm_notifications_title">Okubuulirwa</string>
    <string name="perm_notifications_why">Eraga ekiwandiiko ekitono ekikubuulira nti SandPause ekola.</string>
    <string name="perm_open_settings">Ggulawo settings</string>
    <string name="perm_allow">Kkiriza</string>
    <string name="perm_granted">Ekkirizibwa</string>
    <string name="perm_missing">Tekkirizibwa kati</string>

