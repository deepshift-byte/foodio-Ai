    <string-array name="owner_steps">
        <item>Ddamu okuteekawo fakitole ku ssimu, oba kozesa ssimu etaliiko akawunti. Ggyawo akawunti ya Google n’endala ezisooka.</item>
        <item>Maliriza wizard y’okuteekawo okutuuka ku screen ya Wi-Fi, oluvannyuma ggulawo Developer options ne USB debugging.</item>
        <item>Ddukanya ekiragiro ekiri waggulu. Kirina okulaga: Success: Device owner set.</item>
        <item>Ggulawo SandPause era maliriza okuteekawo bw’ekusaba.</item>
    </string-array>
    <string-array name="oem_transsion_steps">
        <item>Phone Manager (oba Settings > Apps) > SandPause > Autostart: kkiriza.</item>
        <item>Bbaatule: teeka SandPause ku No restrictions.</item>
        <item>Recent apps: sibira SandPause bw’ekiraga akabonero k’okusiba.</item>
    </string-array>
    <string-array name="oem_xiaomi_steps">
        <item>Settings > Apps > Manage apps > SandPause > Autostart: On.</item>
        <item>Battery saver: No restrictions.</item>
        <item>Recent apps: kka wansi ku kaadi ya SandPause era nyiga akabonero k’okusiba.</item>
    </string-array>
    <string-array name="oem_samsung_steps">
        <item>Settings > Apps > SandPause > Battery > Unrestricted.</item>
        <item>Device care > Battery > Background usage limits: ggyako SandPause ku Sleeping apps ne Deep sleeping apps.</item>
    </string-array>
    <string-array name="oem_generic_steps">
        <item>Settings > Apps > SandPause > Battery > Unrestricted oba No restrictions.</item>
        <item>Kkiriza auto-start oba background activity singa essimu yo ekiraga ebyo.</item>
    </string-array>
</resources>
