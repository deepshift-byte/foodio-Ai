    <!-- Permissions -->
    <string name="perm_title">Permissions</string>
    <string name="perm_intro">SandPause needs a few permissions to keep locks working. Each one has a single job, and you can turn any of them off in Settings.</string>
    <string name="perm_overlay_title">Show over other apps</string>
    <string name="perm_overlay_why">So the lock screen can cover a blocked app straight away.</string>
    <string name="perm_usage_title">Usage access</string>
    <string name="perm_usage_why">A backup way to notice which app is open, and to track screen time.</string>
    <string name="perm_accessibility_title">Accessibility (standard lock)</string>
    <string name="perm_accessibility_why">Used to notice when a blocked app opens, so the lock screen can come back. This is the main lock on phones that are not in full-lock mode.</string>
    <string name="perm_disclosure_title">Prominent disclosure</string>
    <string name="perm_disclosure_body">SandPause uses the Accessibility service only to notice which app is in front. It does not read the text on the screen, does not record what the child types, and sends nothing off the phone. Turning it on is needed for locks to work.</string>
    <string name="perm_disclosure_agree">I understand and agree</string>
    <string name="perm_exact_alarm_title">Exact alarms</string>
    <string name="perm_exact_alarm_why">So a scheduled lock starts at the exact minute.</string>
    <string name="perm_battery_title">Battery</string>
    <string name="perm_battery_why">Stops the phone from closing SandPause in the background. Set SandPause to Unrestricted or Not optimised.</string>
    <string name="perm_calls_title">Phone calls</string>
    <string name="perm_calls_why">So the lock screen can call emergency numbers and the parent contacts you chose.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_why">Shows the small note that tells you SandPause is running.</string>
    <string name="perm_open_settings">Open settings</string>
    <string name="perm_allow">Allow</string>
    <string name="perm_granted">Allowed</string>
    <string name="perm_missing">Not allowed yet</string>

    <!-- Full lock (device owner) -->
    <string name="owner_title">Full lock setup</string>
    <string name="owner_intro">On a phone set up as device owner, SandPause pins the lock screen, blocks uninstalling and safe mode, and blocks factory reset from Settings.</string>
    <string name="owner_status_title">Status</string>
    <string name="owner_status_yes">Device owner: yes. Full lock is active.</string>
    <string name="owner_status_no">Device owner: no. Standard lock is used.</string>
    <string name="owner_fallback_note">Standard lock works on any phone. It needs the Accessibility and overlay permissions.</string>
    <string name="owner_adb_title">Set device owner (one time, with adb)</string>
    <string name="owner_adb_hint">On a computer with Android platform tools, connect the phone with USB debugging on, then run:</string>
    <string name="owner_copy">Copy command</string>
    <string name="owner_apply_hardening">Apply protection settings now</string>
