    <string-array name="owner_steps">
        <item>Factory reset the phone, or use a phone with no accounts added yet. Remove Google and other accounts first.</item>
        <item>Finish the setup wizard only up to the Wi-Fi screen, then turn on Developer options and USB debugging.</item>
        <item>Run the command above. It should print: Success: Device owner set.</item>
        <item>Open SandPause and complete setup if it asks you to.</item>
    </string-array>
    <string-array name="oem_transsion_steps">
        <item>Phone Manager (or Settings > Apps) > SandPause > Autostart: allow.</item>
        <item>Battery: set SandPause to No restrictions.</item>
        <item>Recent apps: lock SandPause if the phone shows a lock icon on its card.</item>
    </string-array>
    <string-array name="oem_xiaomi_steps">
        <item>Settings > Apps > Manage apps > SandPause > Autostart: On.</item>
        <item>Battery saver: No restrictions.</item>
        <item>Recent apps: pull down SandPause’s card and tap the lock icon.</item>
    </string-array>
    <string-array name="oem_samsung_steps">
        <item>Settings > Apps > SandPause > Battery > Unrestricted.</item>
        <item>Device care > Battery > Background usage limits: remove SandPause from Sleeping apps and Deep sleeping apps.</item>
    </string-array>
    <string-array name="oem_generic_steps">
        <item>Settings > Apps > SandPause > Battery > Unrestricted or No restrictions.</item>
        <item>Allow auto-start or background activity if your phone shows those options.</item>
    </string-array>

